# [Immich Database]
DB_HOSTNAME=immich_postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_DATABASE_NAME=immich

# [Reverse Geocoding APIs]
VWORLD_API_KEY=your_vworld_api_key_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# [Worker Runtime]
# INTERVAL_HOURS: worker run interval in hours.
# STEP_DELAY_MS: delay between API/cluster processing steps in milliseconds.
# CLUSTER_RADIUS_METERS: radius used to group nearby photos into one coordinate cluster.
# CLUSTER_YIELD_INTERVAL: event-loop yield interval while clustering large batches.
# APPEND_BUILDING_NAME: true adds building names to automatic results; false stores legal-dong level address only.
# API_TIMEOUT_MS: fallback API timeout.
# NAVER_API_TIMEOUT_MS: Naver API timeout; overrides API_TIMEOUT_MS for Naver-related calls.
# NOT_FOUND_CACHE_TTL_DAYS: negative-cache TTL for not-found results.
# BOUNDARY_VALIDATION_MIN_SPAN_METERS: validate cluster extreme points when unique coordinates span at least this distance.
INTERVAL_HOURS=24
STEP_DELAY_MS=100
CLUSTER_RADIUS_METERS=15
CLUSTER_YIELD_INTERVAL=1000
APPEND_BUILDING_NAME=true
API_TIMEOUT_MS=10000
NAVER_API_TIMEOUT_MS=10000
NOT_FOUND_CACHE_TTL_DAYS=30
BOUNDARY_VALIDATION_MIN_SPAN_METERS=10

# [Admin UI]
ADMIN_PORT=3030
ADMIN_ENV_PATH=/app/.env
UPLOAD_LOCATION=/usr/src/app/upload
ADMIN_DEBUG_LOGS=false

# Optional custom raster map style URLs.
IMMICH_MAP_STYLE_LIGHT_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
IMMICH_MAP_STYLE_LIGHT_ATTRIBUTION=© OpenStreetMap contributors
# IMMICH_MAP_STYLE_DARK_TILE_URL=
# IMMICH_MAP_STYLE_DARK_ATTRIBUTION=
# IMMICH_MAP_STYLE_MAX_ZOOM=19
